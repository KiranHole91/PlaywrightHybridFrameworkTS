{
  "name": "playwrightautomationframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:headed": "playwright test --headed",
    "test_SIT_ch_headed": "cross-env ENV_NAME=SIT npx playwright test --project=chromium --headed",
    "test_dev_ff_heeded": "cross-env ENV_NAME=dev npx playwright test --project=firefox --headed",
    "test_SIT_ch_hl": "cross-env ENV_NAME=SIT npx playwright test --project=chromium",
    "test_SIT_ff_hl": "cross-env ENV_NAME=dev npx playwright test --project=firefox",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
"allure:open": "allure open allure-report",
"allure:serve": "allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.3",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^18.0.5"
  }
}
