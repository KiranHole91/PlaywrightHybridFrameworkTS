# Copy to env-files/.env.dev or env-files/.env.SIT and fill in the values.
# Credentials are AES-encrypted: generate each one with  npm run encrypt -- "<value>"
# SECRET_KEY is never stored here; set it in your shell before running tests.

# UI (OrangeHRM)
BASE_URL=https://<orangehrm-host>
USER_NAME=<AES-encrypted username>
PASSWORD=<AES-encrypted password>

# API (Restful-booker)
API_BASE_URL=https://<restful-booker-host>
API_USERNAME=<AES-encrypted username>
API_PASSWORD=<AES-encrypted password>
